# Twitch application credentials from the developer console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Your broadcaster login, in lowercase.
TWITCH_CHANNEL=
# Optional separate bot login; leave empty to use the broadcaster account.
TWITCH_BOT_LOGIN=

# Project API key; required only for commands that call OpenAI.
OPENAI_API_KEY=
# Model service tier: default or fast. Keep default until measured and selected.
CONSENSUS_SERVICE_TIER=default
# Minimum distinct chat authors required for a line, from 1 to 10.
MIN_VOICES=2
# Voice adapter: realtime or legacy.
VOICE_PROVIDER=realtime
MAIN_VOICE=cedar
WHISPER_VOICE=sage

# Local HTTP server port.
PORT=4040
# Set a local WebSocket URL to use a development event server.
EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws?keepalive_timeout_seconds=30
# Development or testing only, leave unset.
# HELIX_URL=http://localhost:8080/helix
# TWITCH_AUTH_URL=http://localhost:8080/oauth2
# TOKEN_FILE=
# Folder for local chat recordings; keep it outside the repository.
# RECORDINGS_DIR=
# Maximum voice and model spend per stream, in USD.
SPEND_CAP_USD=5
# Structured log verbosity: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info
