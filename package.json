{
  "name": "spokesmob",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "eval"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "npm run build --workspace apps/overlay --workspace apps/control",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --config apps/overlay/e2e/playwright.config.ts",
    "dev": "node -e \"console.log('not implemented')\"",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "setup": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/setup.ts",
    "mock": "node --import tsx tools/mock-eventsub/src/cli.ts",
    "record": "node --env-file-if-exists=.env --import tsx tools/recorder/src/cli.ts",
    "twitch:check": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/twitch-check.ts",
    "sim": "node --import tsx tools/crowd-sim/src/cli.ts",
    "consensus": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/consensus.ts",
    "eval": "node --env-file-if-exists=.env --import tsx eval/src/run.ts",
    "voice": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/voice.ts",
    "loop": "node --env-file-if-exists=.env --import tsx apps/server/src/cli/loop.ts",
    "pretest:e2e": "npm run build",
    "posttypecheck": "tsc -p apps/overlay/e2e/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
